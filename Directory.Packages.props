<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning intentionally disabled. With it enabled, the resolver
      picks the *lowest* transitive version it can find (e.g. WebView2 0.8.x
      instead of 1.0.2792.x) and breaks the build. We instead pin CVE-affected
      transitives by adding them as direct PackageReference in the consuming
      project; their versions still come from this file.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Data access -->
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageVersion Include="MySqlConnector" Version="2.5.0" />
    <PackageVersion Include="Npgsql" Version="10.0.0" />

    <!-- Document export (Word / HTML) -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageVersion Include="DocX" Version="3.0.1" />
    <PackageVersion Include="ExCSS" Version="4.2.6" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.11.66" />
    <PackageVersion Include="HtmlToOpenXml.dll" Version="3.2.0" />
    <PackageVersion Include="Markdig" Version="0.37.0" />
    <!-- Rasterize SVG (badges, inline diagrams) and transcode webp to PNG so
         they survive the Word export. Both are managed (no native binaries):
         Svg renders via System.Drawing.Common; ImageSharp 2.1.x is Apache-2.0. -->
    <PackageVersion Include="Svg" Version="3.4.7" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="2.1.13" />

    <!-- Browser rendering -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.55.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />

    <!-- Git (GitHub/GitLab/Bitbucket wiki clone). Bundles native libgit2,
         so no system 'git' install is required on the client. -->
    <PackageVersion Include="LibGit2Sharp" Version="0.31.0" />

    <!-- Azure DevOps -->
    <PackageVersion Include="Microsoft.TeamFoundationServer.ExtendedClient" Version="19.225.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Services.Client" Version="19.225.1" />

    <!-- Auth -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.76.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.76.0" />
    <PackageVersion Include="System.DirectoryServices.AccountManagement" Version="10.0.1" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />

    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Trace" Version="4.0.0" />

    <!-- Misc -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />

    <!--
      Test infrastructure. FluentAssertions stays at 6.12.x because 7.0+
      switched to a commercial license that is incompatible with this
      repo's Apache-2.0 license. xunit 2.9.x is the stable line; xunit 3
      requires a runner upgrade and is not worth the churn yet.
    -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.12.0" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!--
      Transitive pin overrides for known CVEs surfaced by the NuGet
      vulnerability scan (dotnet list package, vulnerable, transitive). These
      packages are dragged in by legacy clients (TFS, OpenXml, DocX).
      Bumping them here forces the restore to a non-vulnerable floor without
      touching the direct deps. Remove entries that become redundant once
      direct deps catch up.
    -->
    <PackageVersion Include="AngleSharp" Version="1.5.0" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.10" />
    <PackageVersion Include="System.IO.Packaging" Version="9.0.0" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

</Project>
