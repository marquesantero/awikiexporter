<UserControl x:Class="ExportAzureWiki.Wpf.Views.AiCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Margin="20" Padding="14" Background="{StaticResource CardBrush}" CornerRadius="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="#334" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- No fixed Width: buttons auto-size to their localized
                         text (e.g. "Generate Summary" in English) with a
                         MinWidth floor for visual consistency. -->
                    <Button MinWidth="130" Margin="0,0,8,0" Content="{Binding SummaryText}" Command="{Binding GenerateSummaryCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button MinWidth="120" Margin="0,0,8,0" Content="{Binding IndexText}" Command="{Binding GenerateIndexCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                    <Button MinWidth="120" Content="{Binding QuizText}" Command="{Binding GenerateQuizCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding DirectQuestionsText}" VerticalAlignment="Center"/>
                <TextBox Width="48" Margin="6,0,12,0" Text="{Binding DirectQuestions}" />
                <TextBlock Text="{Binding MultipleChoiceQuestionsText}" VerticalAlignment="Center"/>
                <TextBox Width="48" Margin="6,0,0,0" Text="{Binding MultipleChoiceQuestions}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding SuggestedTitleText}" VerticalAlignment="Center"/>
                <TextBox Width="280" Margin="8,0,8,0" Text="{Binding SuggestedTitle, UpdateSourceTrigger=PropertyChanged}" />
                <Button Width="190" Content="{Binding ApplyAsPageText}" Command="{Binding ApplyAsAdditionalPageCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="8">
                <TextBox Text="{Binding ResultMarkdown, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
