<Window x:Class="ExportAzureWiki.Wpf.Views.Dialogs.ConnectionTokenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExportAzureWiki.Wpf.Controls"
        Title="{Binding WindowTitle}"
        Width="700"
        Height="420"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding HeaderText}"
                   FontSize="21"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryDarkBrush}" />

        <TextBlock Grid.Row="1"
                   Text="{Binding DescriptionText}"
                   Margin="0,8,0,0"
                   Foreground="#5D6877"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ExpirationHoursText}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Margin="10,0,0,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding ExpirationHours, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2"
                        Margin="12,0,0,0"
                        Padding="16,6"
                        Content="{Binding GenerateText}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="BtnGenerate_OnClick" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding TokenText}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}" />

                <controls:SensitiveTextBox Grid.Row="1"
                                           Margin="0,8,0,0"
                                           Text="{Binding TokenValue, Mode=OneWay}"
                                           IsReadOnly="True"
                                           AcceptsReturn="True"
                                           VerticalScrollBarVisibility="Auto"
                                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#1D3E63"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button Width="130"
                        Content="{Binding CloseText}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="BtnClose_OnClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
