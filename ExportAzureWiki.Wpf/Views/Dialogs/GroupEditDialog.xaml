<Window x:Class="ExportAzureWiki.Wpf.Views.Dialogs.GroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="580"
        Height="420"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Grid.Row="1" Text="{Binding NameText}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Text="{Binding DescriptionText}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Text="{Binding SourceText}" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="{Binding IsSystemText}" IsChecked="{Binding IsSystem}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding CancelText}" Width="120" Margin="0,0,8,0" Click="BtnCancel_OnClick" Style="{StaticResource SecondaryActionButtonStyle}"/>
            <Button Content="{Binding SaveText}" Width="140" Click="BtnSave_OnClick" Style="{StaticResource PrimaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
