<Window x:Class="ExportAzureWiki.Wpf.Views.Dialogs.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExportAzureWiki.Wpf.Controls"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="760"
        MinHeight="620"
        Width="860"
        Height="700"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding AuthModeText}" />
                    <ComboBox Grid.Column="1"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding AuthOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedAuthOption}" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#54636C" TextWrapping="Wrap" Text="{Binding HelpText}" />

                    <Grid Grid.Row="1">
                        <Grid Visibility="{Binding LocalModeVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding UsernameText}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,8" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Binding DisplayNameText}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,8" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{Binding EmailText}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,8" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{Binding PasswordText}" />
                            <controls:SensitiveTextBox Grid.Row="3"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Margin="8,0,0,8"
                                                       Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{Binding ConfirmPasswordText}" />
                            <controls:SensitiveTextBox Grid.Row="4"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Margin="8,0,0,8"
                                                       Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Content="{Binding ActiveText}" IsChecked="{Binding IsActive}" />
                        </Grid>

                        <Grid Visibility="{Binding ExternalModeVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding ProviderText}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,0,8,8"
                                      ItemsSource="{Binding ExternalProviders}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedExternalProvider}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Binding SearchText}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,8,8" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="1" Grid.Column="2" Width="120" Height="30" Content="{Binding SearchButtonText}" Click="BtnSearchExternal_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />

                            <DataGrid Grid.Row="2"
                                      Grid.ColumnSpan="3"
                                      Grid.RowSpan="2"
                                      Margin="0,4,0,8"
                                      ItemsSource="{Binding ExternalCandidates}"
                                      SelectedItem="{Binding SelectedExternalCandidate}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={RelativeSource AncestorType=Window}, Path=DataContext.ExternalNameHeader}" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="{Binding Source={RelativeSource AncestorType=Window}, Path=DataContext.ExternalUsernameHeader}" Binding="{Binding Username}" Width="220"/>
                                    <DataGridTextColumn Header="{Binding Source={RelativeSource AncestorType=Window}, Path=DataContext.ExternalEmailHeader}" Binding="{Binding Email}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="4"
                                    Grid.Column="2"
                                    Width="120"
                                    Height="30"
                                    Margin="0,0,0,8"
                                    Content="{Binding UseSelectedText}"
                                    Click="BtnUseSelectedExternal_OnClick"
                                    Style="{StaticResource SecondaryActionButtonStyle}" />

                            <Grid Grid.Row="5" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding ImportedUserText}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ImportedUserSummary}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="3" Foreground="#1D3E63" TextWrapping="Wrap" Text="{Binding Status}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding CancelText}" Width="120" Margin="0,0,8,0" Click="BtnCancel_OnClick" Style="{StaticResource SecondaryActionButtonStyle}"/>
            <Button Content="{Binding SaveText}" Width="140" Click="BtnSave_OnClick" Style="{StaticResource PrimaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
