<UserControl x:Class="ExportAzureWiki.Wpf.Views.ExportCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Border Margin="20" Padding="20" Background="{StaticResource CardBrush}" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                <TextBlock Margin="0,10,0,0" Text="{Binding Info}" Foreground="#334" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton Content="{Binding CurrentDocumentText}"
                                 IsChecked="{Binding IsCurrentScope}"
                                 Margin="0,0,14,0" />
                    <RadioButton Content="{Binding AllLoadedPagesText}"
                                 IsChecked="{Binding IsAllLoadedPagesScope}"
                                 Margin="0,0,14,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="{Binding IncludeAiPagesText}" IsChecked="{Binding IncludeAdditionalPages}" Margin="0,0,14,0" />
                    <CheckBox Content="{Binding RefreshCacheText}" IsChecked="{Binding RefreshCacheBeforeExport}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding AdditionalPagesInfo}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="{Binding ClearAiPagesText}" Command="{Binding ClearAdditionalPagesCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                </StackPanel>
                <UniformGrid Columns="2" Margin="0,16,0,0">
                    <Button Margin="0,0,6,0"
                            Command="{Binding ExportWordCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/icons/word.png" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ExportWordText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/icons/pdf.png" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ExportPdfText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Margin="0,16,0,0"
                        Padding="16,14"
                        Background="#0B4F7C"
                        CornerRadius="8"
                        BorderBrush="#DFF2FF"
                        BorderThickness="1"
                        Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressTitleText}"
                                   Foreground="#BFE7FF"
                                   FontWeight="Bold"
                                   FontSize="12" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Status}"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   TextWrapping="Wrap" />
                        <ProgressBar Margin="0,12,0,0"
                                     Height="12"
                                     Foreground="#58C4FF"
                                     Background="#0A4268"
                                     IsIndeterminate="True" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,12,0,0" Text="{Binding Status}" Foreground="#334" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
