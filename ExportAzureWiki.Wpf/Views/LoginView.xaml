<UserControl x:Class="ExportAzureWiki.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.Resources>
            <Style x:Key="LoginButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="42" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="InputContainerStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#D5DEE9" />
                <Setter Property="Background" Value="#F7F9FC" />
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="Height" Value="42" />
            </Style>
        </Grid.Resources>

        <Border Width="460"
                Padding="30"
                Background="{StaticResource CardBrush}"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#40000000" />
            </Border.Effect>

            <StackPanel>
                <!-- The logo PNG already carries the product name; no text
                     next to it. BrandTitle stays as the accessibility name. -->
                <Image Source="/Assets/branding/awikiexport_logo.png"
                       Height="120" HorizontalAlignment="Center" Margin="0,0,0,6"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{Binding BrandTitle}" />
                <Border Height="3" Background="{StaticResource PrimaryGreenBrush}" Margin="0,10,0,20" CornerRadius="2" />

                <TextBlock Text="{Binding UsernameLabel}" FontWeight="SemiBold" Foreground="#1F1F1F" />
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,6,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#5D6877"
                                   Text="&#xE77B;" />
                        <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="{StaticResource PrimaryGreenBrush}"
                                 FontWeight="Bold"
                                 FontSize="16"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding PasswordLabel}" FontWeight="SemiBold" Foreground="#1F1F1F" />
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,6,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#5D6877"
                                   Text="&#xE72E;" />
                        <PasswordBox x:Name="txtPassword"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="20"
                                     PasswordChanged="TxtPassword_OnPasswordChanged"
                                     KeyDown="PasswordControl_OnKeyDown" />
                        <TextBox x:Name="txtPasswordVisible"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="20"
                                 Visibility="Collapsed"
                                 TextChanged="TxtPasswordVisible_OnTextChanged"
                                 KeyDown="PasswordControl_OnKeyDown" />
                        <Button x:Name="btnTogglePasswordVisibility"
                                Grid.Column="2"
                                BorderThickness="0"
                                Background="Transparent"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#5D6877"
                                Click="BtnTogglePasswordVisibility_OnClick"
                                Content="&#xE890;" />
                    </Grid>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource LoginButtonStyle}"
                            Click="BtnLogin_OnClick"
                            Command="{Binding LoginCommand}"
                            Background="{StaticResource PrimaryGreenBrush}"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AC;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding SignInText}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource LoginButtonStyle}"
                            Click="BtnLogin_OnClick"
                            Command="{Binding LoginAzureCommand}"
                            IsEnabled="{Binding IsAzureLoginEnabled}"
                            Background="#EEF3FA"
                            Foreground="{StaticResource PrimaryDarkBrush}"
                            BorderThickness="1"
                            BorderBrush="#D5E2F2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE12B;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding SignInAzureText}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Margin="0,12,0,0"
                           Text="{Binding Status}"
                           Foreground="#334"
                           TextWrapping="Wrap" />
                <Border Margin="0,26,0,0"
                        HorizontalAlignment="Right"
                        Background="#F4F7FB"
                        BorderBrush="#DCE5F0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#5D6877"
                                   Margin="0,0,6,0"
                                   Text="{Binding LanguageLabel}" />
                        <ComboBox Width="120"
                                  Height="24"
                                  FontSize="11"
                                  ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
