<UserControl x:Class="ExportAzureWiki.Wpf.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PermissionsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546476"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Margin="16,14,16,10" Padding="14,12" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    <TextBlock Text="{Binding Status}" Margin="0,4,0,0" Foreground="#5B6C7E" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Content="{Binding SaveText}"
                            Command="{Binding SaveCommand}"
                            Width="110"
                            Height="34"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                    <Button Content="{Binding RefreshText}"
                            Command="{Binding RefreshCommand}"
                            Width="110"
                            Height="34"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10,7" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="7">
                        <TextBlock Text="{Binding PoliciesText}" Style="{StaticResource PermissionsSectionTitleStyle}" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding Policies}"
                              SelectedItem="{Binding SelectedPolicy}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colPolicyIdentity" Header="{Binding DataContext.IdentityHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IdentityDisplayName}" Width="250"/>
                            <DataGridTextColumn x:Name="colPolicyType" Header="{Binding DataContext.TypeHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IdentityType}" Width="110"/>
                            <DataGridCheckBoxColumn x:Name="colPolicyAdmin" Header="{Binding DataContext.AdminText, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsAdmin}" Width="80"/>
                            <DataGridTextColumn x:Name="colPolicyWikiRules" Header="{Binding DataContext.WikiRulesHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Wikis.Count}" Width="95"/>
                            <DataGridCheckBoxColumn x:Name="colPolicyManageWikis" Header="{Binding DataContext.ManageWikisText, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding System.ManageWikis}" Width="110"/>
                            <DataGridCheckBoxColumn x:Name="colPolicyManageUsers" Header="{Binding DataContext.ManageUsersText, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding System.ManageUsersAndGroups}" Width="120"/>
                            <DataGridCheckBoxColumn x:Name="colPolicyManagePermissions" Header="{Binding DataContext.ManagePermissionsText, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding System.ManagePermissions}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="10" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10,7" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="7">
                        <TextBlock Text="{Binding PolicyEditorText}" Style="{StaticResource PermissionsSectionTitleStyle}" />
                    </Border>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <CheckBox Content="{Binding AdminText}" IsChecked="{Binding SelectedPolicy.IsAdmin}" Margin="0,0,14,0"/>
                        <CheckBox Content="{Binding ManageWikisText}" IsChecked="{Binding SelectedPolicy.System.ManageWikis}" Margin="0,0,14,0"/>
                        <CheckBox Content="{Binding ManageUsersText}" IsChecked="{Binding SelectedPolicy.System.ManageUsersAndGroups}" Margin="0,0,14,0"/>
                        <CheckBox Content="{Binding ManagePermissionsText}" IsChecked="{Binding SelectedPolicy.System.ManagePermissions}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="2" Text="{Binding WikiRulesText}" Style="{StaticResource PermissionsSectionTitleStyle}" Margin="0,12,0,6"/>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding WikiRules}"
                              SelectedItem="{Binding SelectedRule}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colRuleWikiId" Header="{Binding DataContext.WikiIdHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding WikiId}" Width="130"/>
                            <DataGridTextColumn x:Name="colRuleStartPoints" Header="{Binding DataContext.StartPointsHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding StartPoints}" Width="*"/>
                            <DataGridCheckBoxColumn x:Name="colRuleView" Header="{Binding DataContext.ViewHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding CanView}" Width="65"/>
                            <DataGridCheckBoxColumn x:Name="colRuleComment" Header="{Binding DataContext.CommentHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding CanComment}" Width="85"/>
                            <DataGridCheckBoxColumn x:Name="colRuleWord" Header="{Binding DataContext.WordHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding CanExportWord}" Width="65"/>
                            <DataGridCheckBoxColumn x:Name="colRulePdf" Header="{Binding DataContext.PdfHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding CanExportPdf}" Width="65"/>
                            <DataGridCheckBoxColumn x:Name="colRuleLetterhead" Header="{Binding DataContext.LetterheadHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding CanUseLetterhead}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{Binding AddWikiRuleText}"
                                MinWidth="110"
                                Padding="12,0"
                                Click="BtnAddRule_OnClick"
                                Style="{StaticResource SecondaryActionButtonStyle}"/>
                        <Button Grid.Column="2"
                                Content="{Binding EditWikiRuleText}"
                                MinWidth="110"
                                Padding="12,0"
                                Click="BtnEditRule_OnClick"
                                Style="{StaticResource SecondaryActionButtonStyle}"/>
                        <Button Grid.Column="4"
                                Content="{Binding RemoveSelectedText}"
                                Command="{Binding RemoveWikiRuleCommand}"
                                MinWidth="110"
                                Padding="12,0"
                                Style="{StaticResource SecondaryActionButtonStyle}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
