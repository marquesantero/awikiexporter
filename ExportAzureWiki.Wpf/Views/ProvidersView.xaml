<UserControl x:Class="ExportAzureWiki.Wpf.Views.ProvidersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProvidersSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546476"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Margin="16,14,16,10" Padding="14,12" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    <TextBlock Text="{Binding Status}" Margin="0,4,0,0" Foreground="#5B6C7E" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" Width="110" Height="34"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="16,0,16,10" Padding="12" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                    <Border Margin="0,0,6,0" Padding="10" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Background="#FCFDFF">
                        <StackPanel>
                            <TextBlock Text="{Binding PrimaryMethodGroupText}" Style="{StaticResource ProvidersSectionTitleStyle}" />
                            <ComboBox ItemsSource="{Binding PrimaryMethodOptions}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding PrimaryMethod, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0,0,0" Padding="10" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Background="#FCFDFF">
                        <StackPanel>
                            <TextBlock Text="{Binding AdditionalMethodsGroupText}" Style="{StaticResource ProvidersSectionTitleStyle}" />
                            <StackPanel>
                                <CheckBox Margin="0,0,0,4" Content="{Binding AllowLocalAuthText}" IsChecked="{Binding AllowLocalAuth}" />
                                <CheckBox Margin="0,0,0,4" Content="{Binding AllowWindowsAuthText}" IsChecked="{Binding AllowWindowsAuth}" />
                                <CheckBox Content="{Binding AllowAzureAdAuthText}" IsChecked="{Binding AllowAzureAdAuth}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Grid.Row="1" Columns="1" Margin="0,0,0,10">
                    <Border Margin="0" Padding="10" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Background="#FCFDFF">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWindowsSettingsVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding WindowsGroupText}" Style="{StaticResource ProvidersSectionTitleStyle}" />
                            <CheckBox Content="{Binding SyncWindowsGroupsText}" IsChecked="{Binding SyncWindowsGroups}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="10,7" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="7">
                        <TextBlock Text="{Binding OAuthProvidersText}" Style="{StaticResource ProvidersSectionTitleStyle}" Margin="0" />
                    </Border>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding OAuthProviders}" SelectedItem="{Binding SelectedOAuthProvider}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colOauthProvider" Header="{Binding DataContext.ProviderHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ProviderName}" Width="150"/>
                            <DataGridTextColumn x:Name="colOauthName" Header="{Binding DataContext.NameHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DisplayName}" Width="120"/>
                            <DataGridCheckBoxColumn x:Name="colOauthEnabled" Header="{Binding DataContext.EnabledText, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridTextColumn x:Name="colOauthRedirect" Header="{Binding DataContext.RedirectHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding RedirectUri}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FCFDFF">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedOAuthProvider.DisplayName, TargetNullValue='-'}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedOAuthProvider.ProviderName, TargetNullValue='-'}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedOAuthProvider.RedirectUri, TargetNullValue='-'}" TextWrapping="Wrap"/>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding NewText}" Click="BtnNewOAuth_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding EditText}" Click="BtnEditOAuth_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Content="{Binding DeleteText}" Command="{Binding DeleteOAuthCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="10" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="10,7" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="7">
                        <TextBlock Text="{Binding AiProvidersText}" Style="{StaticResource ProvidersSectionTitleStyle}" Margin="0" />
                    </Border>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding AiProviders}" SelectedItem="{Binding SelectedAiProvider}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colAiDisplay" Header="{Binding DataContext.DisplayHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DisplayName}" Width="160"/>
                            <DataGridTextColumn x:Name="colAiProvider" Header="{Binding DataContext.ProviderHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ProviderName}" Width="120"/>
                            <DataGridTextColumn x:Name="colAiModel" Header="{Binding DataContext.ModelHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ModelName}" Width="120"/>
                            <DataGridCheckBoxColumn x:Name="colAiEnabled" Header="{Binding DataContext.EnabledText, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridCheckBoxColumn x:Name="colAiDefault" Header="{Binding DataContext.DefaultText, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsDefault}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FCFDFF">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAiProvider.DisplayName, TargetNullValue='-'}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedAiProvider.ProviderName, TargetNullValue='-'}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedAiProvider.ModelName, TargetNullValue='-'}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding NewText}" Click="BtnNewAi_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding EditText}" Click="BtnEditAi_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Content="{Binding DeleteText}" Command="{Binding DeleteAiCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
