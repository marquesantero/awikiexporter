<Window x:Class="ExportAzureWiki.Wpf.Views.Setup.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExportAzureWiki.Wpf.Controls"
        Title="{Binding WindowTitle}"
        Width="760"
        Height="640"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5D6877" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D5DEE9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding TitleText}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding StepText}" Foreground="#5D6877" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="0" Background="{StaticResource CardBrush}" CornerRadius="10" BorderBrush="#D5DEE9" BorderThickness="1">
            <TabControl x:Name="tabSteps" SelectedIndex="{Binding CurrentStep, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="16">

                <!-- 0: Language -->
                <TabItem Header="{Binding LanguageTabText}">
                    <StackPanel MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock Text="{Binding LanguageStepTitle}" Style="{StaticResource StepTitle}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LanguageStepDescription}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#5D6877" Margin="0,0,0,18" />
                        <ComboBox Height="36"
                                  FontSize="14"
                                  ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </TabItem>

                <!-- 1: Welcome / install mode -->
                <TabItem Header="{Binding WelcomeTabText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding WelcomeTitle}" Style="{StaticResource StepTitle}" />
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#5D6877" Text="{Binding WelcomeDescription}" />

                            <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Text="{Binding InstallModeText}" />
                            <RadioButton Content="{Binding InstallModeNewText}" IsChecked="{Binding IsNewInstallationMode, Mode=TwoWay}" />
                            <RadioButton Margin="0,8,0,0" Content="{Binding InstallModeExistingText}" IsChecked="{Binding IsExistingInstallationMode, Mode=TwoWay}" />

                            <Border Margin="0,18,0,0" Padding="12" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8">
                                <TextBlock TextWrapping="Wrap" Foreground="#33485F" Text="{Binding WelcomeInfo}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2: Database -->
                <TabItem Header="{Binding DatabaseTabText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding DatabaseTitle}" Style="{StaticResource StepTitle}" />

                            <StackPanel Visibility="{Binding ShowExistingConnectionModeOptions, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,8,0,0">
                                <TextBlock FontWeight="SemiBold" Foreground="#5D6877" Text="{Binding ExistingConnectionModeText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <RadioButton Content="{Binding ExistingConnectionManualText}" IsChecked="{Binding IsExistingManualMode, Mode=TwoWay}" />
                                    <RadioButton Margin="20,0,0,0" Content="{Binding ExistingConnectionTokenText}" IsChecked="{Binding IsExistingTokenMode, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Manual configuration -->
                            <StackPanel Visibility="{Binding ShowManualConfigurationFields, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DbTypeText}" />
                                <ComboBox Height="34" SelectedValue="{Binding SelectedDbType}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="SQLite" Tag="SQLite" />
                                    <ComboBoxItem Content="SQL Server" Tag="SqlServer" />
                                    <ComboBoxItem Content="PostgreSQL" Tag="PostgreSQL" />
                                    <ComboBoxItem Content="MySQL" Tag="MySQL" />
                                </ComboBox>

                                <!-- Server-based fields hidden for SQLite -->
                                <StackPanel Visibility="{Binding ShowServerFields, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DbServerText}" />
                                    <TextBox Style="{StaticResource FieldInput}" controls:Watermark.Text="{Binding DbServerPlaceholder}" Text="{Binding DbServer, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DbDatabaseText}" />
                                            <TextBox Style="{StaticResource FieldInput}" controls:Watermark.Text="{Binding DbDatabasePlaceholder}" Text="{Binding DbDatabase, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DbPortText}" />
                                            <TextBox Style="{StaticResource FieldInput}" controls:Watermark.Text="{Binding DbPortPlaceholder}" Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Margin="0,12,0,0"
                                              Content="{Binding WindowsAuthText}"
                                              IsChecked="{Binding UseWindowsAuth, Mode=TwoWay}"
                                              Visibility="{Binding ShowWindowsAuthOption, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <StackPanel Visibility="{Binding ShowSqlCredentials, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DbUserText}" />
                                        <TextBox Style="{StaticResource FieldInput}" controls:Watermark.Text="{Binding DbUserPlaceholder}" Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DbPasswordText}" />
                                        <controls:SensitiveTextBox Height="34" Text="{Binding DbPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Border Margin="0,14,0,0" Padding="12" Background="#F7F9FC" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AdvancedOptionsText}" FontSize="12" FontWeight="SemiBold" Foreground="#5D6877" Margin="0,0,0,6" />
                                            <CheckBox Content="{Binding TrustServerCertificateText}" IsChecked="{Binding TrustServerCertificate, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding TrustServerCertificateHint}" TextWrapping="Wrap" FontSize="11" Foreground="#8A6D00" Margin="22,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- SQLite file -->
                                <StackPanel Visibility="{Binding ShowFileField, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DbFileText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FieldInput}" controls:Watermark.Text="{Binding DbFilePlaceholder}" Text="{Binding DbFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Width="110" Height="34" Margin="8,0,0,0" Content="{Binding BrowseText}" Click="BtnBrowseDbFile_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                                    </Grid>
                                </StackPanel>

                                <Button HorizontalAlignment="Left" Width="150" Height="34" Margin="0,14,0,0" Content="{Binding TestText}" Click="BtnTestConnection_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                            </StackPanel>

                            <!-- Token configuration -->
                            <StackPanel Visibility="{Binding ShowTokenConfigurationFields, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding TokenText}" />
                                <controls:SensitiveTextBox Height="120"
                                                           AcceptsReturn="True"
                                                           TextWrapping="Wrap"
                                                           VerticalScrollBarVisibility="Auto"
                                                           Text="{Binding ConnectionToken, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="150" Height="34" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{Binding ValidateTokenText}" Click="BtnValidateToken_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                            </StackPanel>

                            <TextBlock Margin="0,14,0,0" Foreground="#1D3E63" TextWrapping="Wrap" Text="{Binding DatabaseStatus}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 3: Admin -->
                <TabItem Header="{Binding AdminTabText}" Visibility="{Binding ShowAdminStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AdminTitle}" Style="{StaticResource StepTitle}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AdminUsernameText}" />
                            <TextBox Style="{StaticResource FieldInput}" controls:Watermark.Text="{Binding AdminUsernamePlaceholder}" Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AdminEmailText}" />
                            <TextBox Style="{StaticResource FieldInput}" controls:Watermark.Text="{Binding AdminEmailPlaceholder}" Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AdminPasswordText}" />
                            <controls:SensitiveTextBox Height="34" Text="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AdminPasswordConfirmText}" />
                            <controls:SensitiveTextBox Height="34" Text="{Binding AdminPasswordConfirm, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Margin="0,16,0,0" Padding="12" Background="#F7F9FC" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding PasswordRequirementsText}" FontSize="12" FontWeight="SemiBold" Foreground="#5D6877" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding PasswordRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Width="18" FontSize="13" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="○" />
                                                                <Setter Property="Foreground" Value="#9AA4B2" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSatisfied}" Value="True">
                                                                        <Setter Property="Text" Value="✓" />
                                                                        <Setter Property="Foreground" Value="#2E9E4F" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#5D6877" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSatisfied}" Value="True">
                                                                        <Setter Property="Foreground" Value="#2E7D43" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 4: Completion -->
                <TabItem Header="{Binding CompletionTabText}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="{Binding CompletionTitle}" Style="{StaticResource StepTitle}" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#5D6877" Text="{Binding CompletionSummary}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#5D6877" TextWrapping="Wrap" Text="{Binding FooterStatus}" />
            <Button Grid.Column="1" Width="120" Height="36" Margin="0,0,8,0" Content="{Binding BackText}" IsEnabled="{Binding CanBack}" Click="BtnBack_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button Grid.Column="2" Width="150" Height="36" Margin="0,0,8,0" Content="{Binding NextText}" IsEnabled="{Binding CanNext}" Click="BtnNext_OnClick" Style="{StaticResource PrimaryActionButtonStyle}" />
            <Button Grid.Column="3" Width="120" Height="36" Content="{Binding CancelText}" Click="BtnCancel_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
        </Grid>
    </Grid>
</Window>
