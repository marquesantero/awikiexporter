<UserControl x:Class="ExportAzureWiki.Wpf.Views.UsersGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AdminSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546476"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Margin="16,14,16,10" Padding="14,12" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    <TextBlock Text="{Binding Status}" Margin="0,4,0,0" Foreground="#5B6C7E" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}"
                        Width="120"
                        Height="34"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10,7" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="7">
                        <TextBlock Text="{Binding UsersSectionTitle}" Style="{StaticResource AdminSectionTitleStyle}" Margin="0"/>
                    </Border>

                    <DataGrid Grid.Row="1" Margin="0,8,0,0"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colUsersId" Header="{Binding DataContext.IdHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn x:Name="colUsersUsername" Header="{Binding DataContext.UsernameHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Username}" Width="150"/>
                            <DataGridTextColumn x:Name="colUsersEmail" Header="{Binding DataContext.EmailHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn x:Name="colUsersDisplay" Header="{Binding DataContext.DisplayNameHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridCheckBoxColumn x:Name="colUsersActive" Header="{Binding DataContext.ActiveHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FCFDFF">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedUser.Username, TargetNullValue='-'}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedUser.Email, TargetNullValue='-'}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedUser.DisplayName, TargetNullValue='-'}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding NewText}" Click="BtnNewUser_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding EditText}" Click="BtnEditUser_OnClick" IsEnabled="{Binding CanEditSelectedUser}" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Content="{Binding DeleteText}" Command="{Binding DeleteUserCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="10" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10,7" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="7">
                        <TextBlock Text="{Binding GroupsSectionTitle}" Style="{StaticResource AdminSectionTitleStyle}" Margin="0"/>
                    </Border>

                    <DataGrid Grid.Row="1" Margin="0,8,0,0"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colGroupsId" Header="{Binding DataContext.IdHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn x:Name="colGroupsName" Header="{Binding DataContext.NameHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn x:Name="colGroupsDescription" Header="{Binding DataContext.DescriptionHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Description}" Width="220"/>
                            <DataGridTextColumn x:Name="colGroupsSource" Header="{Binding DataContext.SourceHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Source}" Width="120"/>
                            <DataGridCheckBoxColumn x:Name="colGroupsSystem" Header="{Binding DataContext.SystemHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsSystem}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FCFDFF">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedGroup.Name, TargetNullValue='-'}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedGroup.Description, TargetNullValue='-'}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedGroup.Source, TargetNullValue='-'}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding MembersText}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedGroupMemberCount}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding NewText}" Click="BtnNewGroup_OnClick" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Margin="0,0,8,0" Content="{Binding EditText}" Click="BtnEditGroup_OnClick" IsEnabled="{Binding CanEditSelectedGroup}" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Width="110" Content="{Binding DeleteText}" Command="{Binding DeleteGroupCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
